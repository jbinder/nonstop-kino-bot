# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional: OMDb API key (https://www.omdbapi.com/apikey.aspx, free tier = 1000 req/day).
# With a key you get IMDb rating, genre and a proper poster per movie.
# Without a key the bot falls back to the IMDb suggestion API (id, poster) and the
# public IMDb ratings dataset (~8 MB download, refreshed weekly) for ratings; genre is then unavailable.
OMDB_API_KEY=

# Optional tuning (defaults shown)
#TZ=Europe/Vienna
#PROGRAM_TTL_HOURS=6          # how often the program page is re-fetched
#MOVIE_TTL_DAYS=30            # movie detail pages
#CINEMA_TTL_DAYS=30           # cinema list/addresses
#IMDB_TTL_DAYS=14             # rating/genre cache
#RATINGS_DATASET_TTL_DAYS=7   # IMDb ratings dataset (keyless mode)
#USE_IMDB_DATASET=1           # 0 = never download the ratings dataset
#EVENING_FROM_HOUR=18         # /abend shows screenings from this hour; "Abend" section boundary
#NOW_WINDOW_HOURS=4           # /jetzt shows screenings starting within N hours
#DETAILS_LINK=deep            # deep = title is a tap link; text = visible /f_<id> command after the title
#DEFAULT_NOTIFY_TIME=08:00
#PREFETCH_DAYS=7              # prefetch details for movies playing within N days
#FETCH_DELAY_SECONDS=0.5      # min spacing between requests to the same host
#USER_AGENT=nonstopkino-telegram-bot/1.0
